PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/entreskill_hub?schema=public
JWT_ACCESS_SECRET=your_short_lived_access_secret_key_change_me
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your_long_lived_refresh_secret_key_change_me
JWT_REFRESH_EXPIRY=7d

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Configurations (for SMTP verification/resets)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_smtp_user
EMAIL_PASS=your_smtp_pass
EMAIL_FROM=no-reply@entreskillhub.com

# Frontend Endpoint (for CORS validation)
FRONTEND_URL=http://localhost:5173

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_placeholder
GOOGLE_CLIENT_SECRET=your_google_client_secret_placeholder
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

